<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- Presentation and input only. The rules live in src/Core. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>TypingShip</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Core\TypingShip.Core.csproj" />
    <Using Include="TypingShip.Core" />
    <!-- Data ships inside the game assembly, so exports carry it. In a checkout the game reads ../data directly
         instead, so edited level files can be reloaded while it runs. -->
    <EmbeddedResource Include="..\data\**\*.txt" LogicalName="data/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Steam (scripts/Platform/SteamPlatform.cs): Steamworks.NET, and Valve's steam_api library from
       steam/redist (see steam/README.md) next to the game assembly. Exports carry the one for their platform; a
       build without a runtime (the editor, dotnet build) gets the Windows one. -->
  <ItemGroup>
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
    <None Include="..\steam\redist\steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))" />
    <None Include="..\steam\redist\libsteam_api.so" Link="libsteam_api.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
  </ItemGroup>
</Project>
